<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DesktopDashboard.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DesktopDashboard.Controls"
    xmlns:vm="using:DesktopDashboard.ViewModels"
    Title="Desktop Dashboard">

    <Grid x:Name="Root">
        <Grid.Resources>
            <DataTemplate x:Key="CardTemplate" x:DataType="vm:CardViewModel">
                <controls:MetricCard ViewModel="{x:Bind}" />
            </DataTemplate>

            <Style x:Key="ChromeButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
        </Grid.Resources>

        <Grid.ChildrenTransitions>
            <EntranceThemeTransition FromVerticalOffset="16" />
        </Grid.ChildrenTransitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: the left column (title + clock) is the drag area, the right column holds buttons. -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="DragRegion" Background="Transparent" Padding="16,10,8,6">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE9D9;" FontSize="12" Foreground="{ThemeResource DashboardAccentBrush}" />
                    <TextBlock Text="Dashboard" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <Viewbox Height="{x:Bind ViewModel.ClockHeight, Mode=OneWay}" HorizontalAlignment="Left" Margin="0,6,0,0"
                         Visibility="{x:Bind ViewModel.ShowClock, Mode=OneWay}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{x:Bind ViewModel.Clock.TimeText, Mode=OneWay}"
                                       FontFamily="Segoe UI Variable Display" FontWeight="SemiBold" FontSize="44"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.Clock.SecondsText, Mode=OneWay}"
                                       FontFamily="Segoe UI Variable Display" FontSize="20" Margin="0,0,0,9"
                                       VerticalAlignment="Bottom" Foreground="{ThemeResource DashboardAccentBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.Clock.MeridiemText, Mode=OneWay}"
                                       FontSize="14" Margin="2,0,0,10" VerticalAlignment="Bottom"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.Clock.DateText, Mode=OneWay}" FontSize="14" Margin="2,-4,0,0"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Viewbox>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,6,6,0">
                <Button x:Name="PinButton" Style="{StaticResource ChromeButtonStyle}" Click="OnPinClick">
                    <FontIcon x:Name="PinIcon" Glyph="&#xE718;" FontSize="12" />
                </Button>
                <Button x:Name="SettingsButton" Style="{StaticResource ChromeButtonStyle}" Click="OnSettingsClick"
                        ToolTipService.ToolTip="Settings">
                    <FontIcon Glyph="&#xE713;" FontSize="12" />
                </Button>
                <Button x:Name="HideButton" Style="{StaticResource ChromeButtonStyle}" Click="OnHideClick"
                        ToolTipService.ToolTip="Hide to tray">
                    <FontIcon Glyph="&#xE921;" FontSize="12" />
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" Padding="12,4,12,12" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Cards}" ItemTemplate="{StaticResource CardTemplate}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MinItemWidth="{x:Bind ViewModel.CardWidth, Mode=OneWay}"
                                       MinItemHeight="{x:Bind ViewModel.CardHeight, Mode=OneWay}"
                                       MinRowSpacing="8" MinColumnSpacing="8"
                                       ItemsStretch="Fill" />
                </ItemsRepeater.Layout>
            </ItemsRepeater>
        </ScrollViewer>
    </Grid>
</Window>
